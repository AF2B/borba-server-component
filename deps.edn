{:paths ["src"]

 :deps
 {org.clojure/clojure          {:mvn/version "1.12.6"}
  integrant/integrant          {:mvn/version "1.0.1"}
  io.pedestal/pedestal.service {:mvn/version "0.8.2"}
  io.pedestal/pedestal.jetty   {:mvn/version "0.8.2"}
  org.clojure/tools.logging    {:mvn/version "1.3.1"}

  ;; Pedestal 0.8.2 brings Jackson 2.21.1 through transit-java, which has three
  ;; high advisories (GHSA-7hhh-6rmp-j9qf, GHSA-p6pp-m3f8-5c89 and
  ;; GHSA-r7wm-3cxj-wff9), fixed in 2.22.3. Remove the line when Pedestal
  ;; moves to a Jackson that has the fixes.
  com.fasterxml.jackson.core/jackson-core {:mvn/version "2.22.3"}}

 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps  {lambdaisland/kaocha    {:mvn/version "1.91.1392"}
                 org.clojure/test.check {:mvn/version "1.1.3"}
                 org.slf4j/slf4j-simple {:mvn/version "2.0.13"}}
   :main-opts   ["-m" "kaocha.runner"]}

  :coverage
  {:extra-paths ["test"]
   :extra-deps  {lambdaisland/kaocha           {:mvn/version "1.91.1392"}
                 lambdaisland/kaocha-cloverage {:mvn/version "1.1.89"}
                 org.clojure/test.check        {:mvn/version "1.1.3"}
                 org.slf4j/slf4j-simple        {:mvn/version "2.0.13"}}
   :main-opts   ["-m" "kaocha.runner" "--plugin" "cloverage"
                 "--cov-fail-threshold" "90"
                 "--cov-output" "target/coverage"
                 "--focus" ":unit"]}

  :lint
  {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
   :main-opts    ["-m" "clj-kondo.main" "--lint" "src" "test"
                  "--fail-level" "warning"]}

  :fmt
  {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.16.6"}}
   :main-opts    ["-m" "cljfmt.main"]}

  :build
  {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
   :ns-default build
   :exec-args  {:lib         io.github.af2b/borba-server-component
                :description "The HTTP server of a Borba service: Pedestal on Jetty, with HTTP/1.1 by default, an ephemeral port for tests and a graceful stop that lets the requests in flight finish."}}

  :outdated
  {:replace-deps {com.github.liquidz/antq {:mvn/version "2.11.1276"}}
   :main-opts    ["-m" "antq.core" "--error-format"
                  "{{name}} {{version}} -> {{latest-version}}"]}}}
