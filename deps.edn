{:paths ["src"]

 :deps
 {org.clojure/clojure          {:mvn/version "1.12.0"}
  integrant/integrant           {:mvn/version "0.8.1"}
  io.pedestal/pedestal.service  {:mvn/version "0.7.0"}
  io.pedestal/pedestal.jetty    {:mvn/version "0.7.0"}
  org.slf4j/slf4j-simple        {:mvn/version "2.0.13"}}

 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps  {lambdaisland/kaocha          {:mvn/version "1.91.1392"}
                 lambdaisland/kaocha-cloverage {:mvn/version "1.1.89"}
                 cloverage/cloverage          {:mvn/version "1.2.4"}}}

  :fmt-check
  {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.12.0"}}
   :main-opts  ["-m" "cljfmt.main" "check" "src"]}

  :fmt-fix
  {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.12.0"}}
   :main-opts  ["-m" "cljfmt.main" "fix" "src"]}

  :lint
  {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2024.09.27"}}
   :main-opts  ["-m" "clj-kondo.main" "--lint" "src"]}

  :build
  {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
   :ns-default build}}}
